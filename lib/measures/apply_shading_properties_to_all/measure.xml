  <class_name>ApplyShadingPropertiesToAll</class_name>
  <display_name>Apply Shading Properties To All Site and Building Shading Surfaces</display_name>
  <description>
     Assigns a Construction and/or Transmittance Schedule to every shading
    surface that belongs to a ShadingSurfaceGroup with Shading Surface Type of
    Site or Building. 
  </description>
  <modeler_description>
     Iterates all ShadingSurfaceGroup objects in the model. For groups whose
    shadingSurfaceType is "Site" or "Building", calls setConstruction and/or
    setTransmittanceSchedule on each child ShadingSurface. A value of "--- No
    Change ---" skips that property. 
  </modeler_description>
  <arguments>
    <argument>
      <name>construction</name>
      <display_name>Construction to Assign (or "No Change")</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0</default_value>
      <choices>
        <choice>
          <value>0</value>
          <display_name>--- No Change ---</display_name>
        </choice>
      </choices>
    </argument>
    <argument>
      <name>schedule</name>
      <display_name>Transmittance Schedule to Assign (or "No Change")</display_name>
      <type>Choice</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0</default_value>
      <choices>
        <choice>
          <value>0</value>
          <display_name>--- No Change ---</display_name>
        </choice>
      </choices>
    </argument>
  </arguments>
